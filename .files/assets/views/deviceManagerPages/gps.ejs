            min-height: 46px;
        }

        /* Log table → cards */
        table.ui.celled.table.gps-log-table thead {
            display: none;
        }

        table.ui.celled.table.gps-log-table tbody tr.gps-log-row {
            display: block;
            background: rgba(10, 14, 23, 0.6) !important;
            border: 1px solid rgba(34, 48, 71, 0.7) !important;
            border-radius: 12px !important;
            padding: 12px 14px !important;
            margin-bottom: 10px !important;
            animation: none;
        }

        table.ui.celled.table.gps-log-table tbody tr.gps-log-row.active {
            border-left: 3px solid #00d9ff !important;
        }

        table.ui.celled.table.gps-log-table tbody td {
            display: flex !important;
            justify-content: space-between;
            align-items: center;
            padding: 6px 0 !important;
            border: none !important;
            font-size: 0.85rem;
            text-align: right;
            gap: 12px;
        }

        table.ui.celled.table.gps-log-table tbody td::before {
            content: attr(data-label);
            color: #5a6675;
            font-size: 0.65rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            text-align: left;
            flex-shrink: 0;
        }

        table.ui.celled.table.gps-log-table tbody td:first-child::before {
            display: none;
        }

        table.ui.celled.table.gps-log-table tbody td:first-child {
            border-bottom: 1px solid rgba(34, 48, 71, 0.5) !important;
            padding-bottom: 10px !important;
            margin-bottom: 4px !important;
        }

        .gps-view-btn {
            width: 100%;
            justify-content: center;
            padding: 10px;
        }

        /* Settings */
        .gps-settings-card {
            padding: 20px 16px;
            border-radius: 14px;
        }

        .gps-settings-icon {
            width: 56px;
            height: 56px;
        }

        .gps-settings-icon .icon {
            font-size: 1.5rem !important;
        }

        .gps-settings-title {
            font-size: 1rem !important;
        }

        .gps-settings-desc {
            font-size: 0.8rem !important;
        }

        .gps-settings-input-row {
            flex-direction: column;
        }

        .gps-interval-input,
        .ui.dropdown.label.gps-interval-unit,
        .ui.positive.button.gps-set-btn {
            width: 100% !important;
        }

        .ui.dropdown.label.gps-interval-unit {
            min-width: 0 !important;
        }

        .ui.positive.button.gps-set-btn {
            justify-content: center;
        }
    }

    /* Small phones */
    @media (max-width: 400px) {
        .ui.top.attached.tabular.menu.gps-tabs .item {
            font-size: 0.65rem !important;
            padding: 9px 4px !important;
        }

        .ui.top.attached.tabular.menu.gps-tabs .item .icon {
            font-size: 0.78rem;
        }

        .gps-map {
            height: 220px !important;
        }

        .gps-settings-title {
            font-size: 0.9rem !important;
            letter-spacing: 1.2px;
        }
    }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
        .gps-map-badge .icon.dot.circle,
        .gps-settings-icon,
        .gps-pulse-marker .pulse-ring {
            animation: none !important;
        }
        table.ui.celled.table.gps-log-table tbody tr.gps-log-row {
            animation: none !important;
        }
    }
</style>

<script>
    /* ============================================
       Original logic — UNCHANGED
       ============================================ */
    $('.menu .item').tab({
        onVisible: () => {
            GPS_NOW_MAP.invalidateSize();
            GPS_LOG_MAP.invalidateSize();
        }
    });

    $('.ui.dropdown').dropdown()

    function gpsIntervalToS() {
        var intMes = $('#intervalMeasure').text();
        var multiplier = 1;
        if (intMes === "hours") multiplier = 3600;
        if (intMes === "minutes") multiplier = 60;
        return ($('#gpsInterval').val() * multiplier);
    }

    function updateGPSInterval() {
        $.post(baseURL + '/GPSPOLL/' + gpsIntervalToS(), function (data) {
            if (data.error) showNotification('#f03434', data.error)
            else showNotification('#2ecc71', 'GPS Interval Updated!');
        });
    }

    var mapData = JSON.parse('<%- JSON.stringify(sorted) %>');

    // Auto-load the most recent day's trail
    <% if (Object.keys(sorted).length > 0) { %>
    loadLogToMap('<%= Object.keys(sorted)[Object.keys(sorted).length -1] %>');
    <% } %>
</script>