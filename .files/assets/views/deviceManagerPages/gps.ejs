        display: inline-flex !important;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
    }

    .ui.positive.button.gps-set-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 30px rgba(0, 255, 157, 0.55) !important;
    }

    .ui.positive.button.gps-set-btn .icon {
        margin: 0 !important;
    }

    /* ============================================
       EMPTY STATE
       ============================================ */
    .gps-empty {
        padding: 40px 20px;
