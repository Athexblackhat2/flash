<div class="no-page-state">

    <!-- Floating background orbs -->
    <div class="np-orb np-orb-1"></div>
    <div class="np-orb np-orb-2"></div>

    <div class="np-content">

        <!-- Animated icon -->
        <div class="np-icon-wrap">
            <div class="np-icon-ring"></div>
            <div class="np-icon-ring np-icon-ring-2"></div>
            <div class="np-icon">
                <i class="icon compass outline"></i>
            </div>
        </div>

        <!-- Text -->
        <h1 class="np-title">No Page Selected</h1>
        <p class="np-subtitle">
            Choose a category from the menu to view details about this device.
        </p>

        <!-- Action buttons -->
        <div class="np-actions">
            <a href="#" class="np-btn np-btn-primary" onclick="openFirstMenuItem(event)">
                <i class="icon arrow right"></i>
                <span>Open Info</span>
            </a>
            <button type="button" class="np-btn np-btn-secondary" onclick="toggleMenuFromHere()">
                <i class="icon list"></i>
                <span>Show Menu</span>
            </button>
        </div>

    </div>

</div>

<style type="text/css">
    /* ============================================
       NO PAGE SELECTED — Animated Empty State
       ============================================ */

    .no-page-state {
        position: relative;
        min-height: 460px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
        background: rgba(19, 26, 38, 0.55);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(0, 217, 255, 0.15);
        border-radius: 20px;
        overflow: hidden;
        isolation: isolate;
    }

    /* ============================================
       Background orbs
       ============================================ */
    .np-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(70px);
        opacity: 0.3;
        pointer-events: none;
        z-index: 0;
        animation: npOrbFloat 12s ease-in-out infinite;
    }

    .np-orb-1 {
        width: 220px;
        height: 220px;
        background: #00d9ff;
        top: -70px;
        left: -70px;
        animation-delay: 0s;
    }

    .np-orb-2 {
        width: 200px;
        height: 200px;
        background: #7c3aed;
        bottom: -60px;
        right: -60px;
        animation-delay: -6s;
    }

    @keyframes npOrbFloat {
        0%, 100% { transform: translate(0, 0) scale(1); }
        33%      { transform: translate(25px, -35px) scale(1.1); }
        66%      { transform: translate(-18px, 22px) scale(0.95); }
    }

    /* ============================================
       Content
       ============================================ */
    .np-content {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        max-width: 460px;
        width: 100%;
    }

    /* ============================================
       Icon
       ============================================ */
    .np-icon-wrap {
        position: relative;
        width: 130px;
        height: 130px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 28px;
    }

    .np-icon-ring {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        border: 1px solid rgba(0, 217, 255, 0.35);
        animation: npRingPulse 2.6s ease-out infinite;
    }

    .np-icon-ring-2 {
        animation-delay: 1.3s;
        border-color: rgba(124, 58, 237, 0.35);
    }

    @keyframes npRingPulse {
        0% {
            transform: scale(0.7);
            opacity: 0.8;
        }
        100% {
            transform: scale(1.4);
            opacity: 0;
        }
    }

    .np-icon {
        position: relative;
        width: 88px;
        height: 88px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient(
            circle at 30% 30%,
            rgba(0, 217, 255, 0.18),
            rgba(124, 58, 237, 0.12)
        );
        border: 2px solid rgba(0, 217, 255, 0.35);
        box-shadow:
            0 0 30px rgba(0, 217, 255, 0.3),
            inset 0 0 25px rgba(0, 217, 255, 0.1);
        animation: npIconFloat 4s ease-in-out infinite;
    }

    @keyframes npIconFloat {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        50%      { transform: translateY(-6px) rotate(15deg); }
    }

    .np-icon .icon.compass {
        font-size: 2.3rem !important;
        color: #00d9ff !important;
        margin: 0 !important;
        filter: drop-shadow(0 0 12px rgba(0, 217, 255, 0.7));
    }

    /* ============================================
       Text
       ============================================ */
    .np-title {
        font-size: 1.35rem !important;
        font-weight: 800 !important;
        text-transform: uppercase;
        letter-spacing: 3px;
        color: #e6edf3 !important;
        margin: 0 0 12px 0 !important;
        text-shadow: 0 0 20px rgba(0, 217, 255, 0.3);
        line-height: 1.2;
    }

    .np-subtitle {
        font-size: 0.9rem;
        line-height: 1.65;
        color: #8b98a8;
        margin: 0 0 28px 0;
        max-width: 360px;
    }

    /* ============================================
       Action buttons
       ============================================ */
    .np-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        justify-content: center;
        width: 100%;
    }

    .np-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 22px;
        border-radius: 12px;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        text-decoration: none !important;
        cursor: pointer;
        transition: all 0.25s ease;
        font-family: inherit;
        border: 1px solid transparent;
        min-height: 46px;
        white-space: nowrap;
        position: relative;
        overflow: hidden;
    }

    .np-btn .icon {
        margin: 0 !important;
        font-size: 0.9rem;
        transition: transform 0.2s ease;
    }

    /* Primary */
    .np-btn-primary {
        background: linear-gradient(135deg, #00d9ff 0%, #7c3aed 100%);
        color: #fff !important;
        box-shadow: 0 0 20px rgba(0, 217, 255, 0.3);
    }

    .np-btn-primary::after {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);
        transition: left 0.6s ease;
    }

    .np-btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 35px rgba(0, 217, 255, 0.55);
        color: #fff !important;
    }

    .np-btn-primary:hover::after {
        left: 100%;
    }

    .np-btn-primary:hover .icon {
        transform: translateX(3px);
    }

    /* Secondary */
    .np-btn-secondary {
        background: rgba(10, 14, 23, 0.7);
        border-color: rgba(0, 217, 255, 0.3);
        color: #00d9ff !important;
    }

    .np-btn-secondary:hover {
        background: rgba(0, 217, 255, 0.1);
        border-color: rgba(0, 217, 255, 0.6);
        color: #00d9ff !important;
        transform: translateY(-2px);
        box-shadow: 0 0 20px rgba(0, 217, 255, 0.3);
    }

    /* ============================================
       MOBILE
       ============================================ */
    @media (max-width: 600px) {
        .no-page-state {
            min-height: 420px;
            padding: 40px 18px;
            border-radius: 16px;
        }

        .np-icon-wrap {
            width: 110px;
            height: 110px;
            margin-bottom: 24px;
        }

        .np-icon {
            width: 74px;
            height: 74px;
        }

        .np-icon .icon.compass {
            font-size: 1.9rem !important;
        }

        .np-title {
            font-size: 1.05rem !important;
            letter-spacing: 2px;
        }

        .np-subtitle {
            font-size: 0.82rem;
            margin-bottom: 24px;
        }

        .np-actions {
            flex-direction: column;
            gap: 10px;
        }

        .np-btn {
            width: 100%;
            padding: 12px 18px;
            font-size: 0.78rem;
        }
    }

    /* Very small phones */
    @media (max-width: 400px) {
        .no-page-state {
            padding: 32px 14px;
            min-height: 380px;
        }

        .np-icon-wrap {
            width: 100px;
            height: 100px;
        }

        .np-icon {
            width: 66px;
            height: 66px;
        }

        .np-icon .icon.compass {
            font-size: 1.7rem !important;
        }

        .np-title {
            font-size: 0.95rem !important;
            letter-spacing: 1.5px;
        }

        .np-subtitle {
            font-size: 0.78rem;
        }
    }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
        .np-orb,
        .np-icon,
        .np-icon-ring {
            animation: none !important;
        }
    }
</style>

<script>
    /* ============================================
       Helper actions — small UX niceties
       ============================================ */

    // "Open Info" — navigate to the first item in the device menu
    function openFirstMenuItem(e) {
        if (e) e.preventDefault();
        var firstItem = document.querySelector('.device-menu .item');
        if (firstItem && firstItem.href) {
            window.location.href = firstItem.href;
            return;
        }
        // Fallback: try baseURL pattern
        var baseURL = (window.baseURL || '').toString();
        if (baseURL) {
            window.location.href = baseURL + '/info';
        }
    }

    // "Show Menu" — on mobile, open the collapsible sidebar
    function toggleMenuFromHere() {
        // Check if the mobile toggle exists (deviceManagerMenu.ejs)
        var toggle = document.getElementById('menuToggle');
        var menu = document.getElementById('deviceMenu');

        if (toggle && menu && window.innerWidth <= 991) {
            // Ensure menu is open
            if (!menu.classList.contains('open')) {
                menu.classList.add('open');
                toggle.classList.add('open');
                try { sessionStorage.setItem('deviceMenuOpen', '1'); } catch (e) {}
            }
            // Scroll the menu into view smoothly
            setTimeout(function () {
                menu.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 100);
        } else {
            // On desktop, the menu is always visible.
            // Scroll to the top of the page where the menu is.
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    }
</script>