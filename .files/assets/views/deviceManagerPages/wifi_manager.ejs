            display: inline-block;
            max-width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .wifi-time {
            font-size: 0.72rem;
            width: 100%;
        }
    }

    /* Small phones */
    @media (max-width: 400px) {
        .wifi-title { font-size: 0.8rem; }
        .wifi-title .icon { font-size: 1rem; }
        .wifi-count { font-size: 0.65rem !important; }
        .wifi-section-title { font-size: 0.75rem; }
        .wifi-ssid-icon { width: 38px; height: 38px; }
        .wifi-ssid-name { font-size: 0.82rem; }
    }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
        .wifi-title .icon.wifi,
        .wifi-count,
        .wifi-live-dot,
        table.ui.celled.table.wifi-table tbody tr.wifi-row {
            animation: none !important;
        }
    }
</style>

<script>
    (function () {
        /* ============================================
           Live search filter across both tables
           ============================================ */
        var searchInput = document.getElementById('wifiSearch');
        var nowTbody = document.getElementById('wifiNowTbody');
        var logTbody = document.getElementById('wifiLogTbody');
        var emptySearch = document.getElementById('wifiEmptySearch');
        var countBadge = document.getElementById('wifiCount');

        if (searchInput) {
            searchInput.addEventListener('input', function () {
                var q = this.value.toLowerCase().trim();
                var visible = 0;
                var total = 0;

                [nowTbody, logTbody].forEach(function (tbody) {
                    if (!tbody) return;
                    var rows = tbody.querySelectorAll('tr.wifi-row');
                    rows.forEach(function (row) {
                        total++;
                        var text = row.textContent.toLowerCase();
                        if (!q || text.indexOf(q) !== -1) {
                            row.style.display = '';
                            visible++;
                        } else {
                            row.style.display = 'none';
                        }
                    });
                });

                // Show/hide empty search state
                if (emptySearch) {
                    emptySearch.style.display = (q && visible === 0 && total > 0) ? 'block' : 'none';
                }

                // Update count badge
                if (countBadge) {
                    var icon = countBadge.querySelector('i.icon');
                    var iconHTML = icon ? icon.outerHTML : '';
                    countBadge.innerHTML = iconHTML + ' ' + visible;
                }

                // Hide section empty states when searching (since we have our own)
                // But show them back when search is cleared and they still have no items
            });
        }
    })();
</script>