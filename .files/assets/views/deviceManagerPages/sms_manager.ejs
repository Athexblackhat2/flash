</style>

<script>
    /* ============================================
       Original logic — UNCHANGED
       ============================================ */
    $('.menu .item').tab();

    function sendSMS(element) {
        $(element).addClass('loading')
        sendCommand('0xSM', {
            'action': 'sendSMS',
            'sms': $('#sms').val(),
            'to': $('#to').val()
        }, (error, message) => {
            if (error) {
                setTimeout(() => {
                    showNotification('#f03434', error)
                    $(element).removeClass('loading')
                }, 300)
            } else {
                setTimeout(() => {
                    $(element).removeClass('loading');
                    if (message === 'Requested') showNotification('#2ecc71', 'SMS Sent');
                    else showNotification('#2ecc71', message);
                }, 300)
            }
        });
    }

    /* ============================================
       New: Live search on SMS log
       ============================================ */
    (function () {
        var searchInput = document.getElementById('smsLogSearch');
        var feed = document.getElementById('smsFeed');
        var emptySearch = document.getElementById('smsEmptySearch');
        var countBadge = document.getElementById('smsLogCount');

        if (searchInput && feed) {
            searchInput.addEventListener('input', function () {
                var q = this.value.toLowerCase().trim();
                var bubbles = feed.querySelectorAll('.sms-bubble-wrap');
                var visible = 0;

                bubbles.forEach(function (b) {
                    var text = b.textContent.toLowerCase();
                    if (!q || text.indexOf(q) !== -1) {
                        b.style.display = '';
                        visible++;
                    } else {
                        b.style.display = 'none';
                    }
                });

                if (emptySearch) {
                    emptySearch.style.display = (visible === 0 && bubbles.length > 0) ? 'block' : 'none';
                }

                if (countBadge) {
                    var icon = countBadge.querySelector('i.icon');
                    var iconHTML = icon ? icon.outerHTML : '';
                    countBadge.innerHTML = iconHTML + ' ' + visible;
                }
            });
        }

        /* Character count for compose */
        var smsInput = document.getElementById('sms');
        var charCount = document.getElementById('smsCharCount');
        if (smsInput && charCount) {
            smsInput.addEventListener('input', function () {
                charCount.textContent = this.value.length;
            });
        }
    })();
</script>