<!DOCTYPE html>
<html lang="en">

<% include partials/head.ejs %>

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#0a0e17">
</head>

<body>
    <style type="text/css">
        /* ============================================
           LOGS PAGE - Terminal Aesthetic
           Dark neon theme
           ============================================ */

        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont,
                         'Segoe UI', Roboto, sans-serif;
            background: #0a0e17;
            background-image:
                radial-gradient(circle at 10% 5%, rgba(124, 58, 237, 0.13), transparent 40%),
                radial-gradient(circle at 90% 95%, rgba(0, 217, 255, 0.10), transparent 40%);
            background-attachment: fixed;
            color: #e6edf3;
            min-height: 100vh;
        }

        .ui.container {
            width: 100% !important;
            max-width: 1400px !important;
            margin: 0 auto !important;
            padding: 20px 16px 40px !important;
        }

        /* Main segment */
        .ui.segment {
            background: rgba(19, 26, 38, 0.75) !important;
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(0, 217, 255, 0.15) !important;
            border-radius: 20px !important;
            box-shadow:
                0 20px 60px rgba(0, 0, 0, 0.5),
                0 0 0 1px rgba(255, 255, 255, 0.03),
                inset 0 1px 0 rgba(255, 255, 255, 0.06) !important;
            padding: 24px !important;
            margin-top: 8px !important;
        }

        /* ============================================
           Logs Terminal Box
           ============================================ */
        .logs {
            position: relative;
            background: #0d1117 !important;
            background-image:
                linear-gradient(rgba(0, 217, 255, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 217, 255, 0.03) 1px, transparent 1px) !important;
            background-size: 40px 40px !important;
            border: 1px solid rgba(0, 217, 255, 0.2) !important;
            border-radius: 14px !important;
            box-shadow:
                inset 0 0 60px rgba(0, 217, 255, 0.05),
                0 0 40px rgba(0, 217, 255, 0.08),
                0 10px 30px rgba(0, 0, 0, 0.5) !important;
            min-height: 620px !important;
            max-height: 70vh !important;
            width: 100%;
            overflow-y: auto !important;
            overflow-x: hidden !important;
            padding: 56px 20px 20px 20px !important;
            font-family: 'JetBrains Mono', 'SF Mono', Menlo, Monaco,
                         'Courier New', monospace !important;
            font-size: 13.5px !important;
            line-height: 1.7 !important;
            word-wrap: break-word;
            color: #c5cfdb;
            scroll-behavior: smooth;
        }

        /* Terminal header bar (fake Mac-style dots + title) */
        .logs::before {
            content: '●  ●  ●   flash  ·  LOGS  ·  LIVE';
            position: sticky;
            top: -56px;
            display: block;
            margin: -56px -20px 20px -20px;
            padding: 14px 20px;
            background: rgba(10, 14, 23, 0.92);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            color: #5a6675;
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            border-bottom: 1px solid rgba(0, 217, 255, 0.15);
            border-radius: 14px 14px 0 0;
            z-index: 2;
            user-select: none;
        }

        /* Custom scrollbar */
        .logs::-webkit-scrollbar {
            width: 10px;
        }

        .logs::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.3);
            border-radius: 5px;
        }

        .logs::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, #00d9ff, #7c3aed);
            border-radius: 5px;
            border: 2px solid #0d1117;
        }

        .logs::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(180deg, #00e8ff, #8d4af7);
        }

        /* ============================================
           Individual log entries
           ============================================ */
        .logs .logitm {
            display: block;
            padding: 8px 12px 8px 14px;
            margin: 4px 0;
            border-left: 2px solid rgba(0, 217, 255, 0.2);
            border-radius: 6px;
            background: rgba(10, 14, 23, 0.4);
            transition: all 0.2s ease;
            animation: logEntry 0.3s ease backwards;
            font-feature-settings: 'tnum';
        }

        .logs .logitm:hover {
            background: rgba(0, 217, 255, 0.06);
            border-left-color: #00d9ff;
            transform: translateX(2px);
        }

        @keyframes logEntry {
            from {
                opacity: 0;
                transform: translateX(-8px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        /* Stagger delay — first 20 items */
        .logs .logitm:nth-child(1)  { animation-delay: 0.00s; }
        .logs .logitm:nth-child(2)  { animation-delay: 0.02s; }
        .logs .logitm:nth-child(3)  { animation-delay: 0.04s; }
        .logs .logitm:nth-child(4)  { animation-delay: 0.06s; }
        .logs .logitm:nth-child(5)  { animation-delay: 0.08s; }
        .logs .logitm:nth-child(6)  { animation-delay: 0.10s; }
        .logs .logitm:nth-child(7)  { animation-delay: 0.12s; }
        .logs .logitm:nth-child(8)  { animation-delay: 0.14s; }
        .logs .logitm:nth-child(9)  { animation-delay: 0.16s; }
        .logs .logitm:nth-child(10) { animation-delay: 0.18s; }
        .logs .logitm:nth-child(n+11) { animation-delay: 0.2s; }

        /* ============================================
           Log level colors
           ============================================ */
        .logs .logitm.INFO {
            color: #54c8ff !important;
            border-left-color: rgba(84, 200, 255, 0.5);
        }

        .logs .logitm.SUCCESS {
            color: #00ff9d !important;
            border-left-color: rgba(0, 255, 157, 0.5);
            text-shadow: 0 0 8px rgba(0, 255, 157, 0.3);
        }

        .logs .logitm.ERROR {
            color: #ff3860 !important;
            border-left-color: rgba(255, 56, 96, 0.5);
            text-shadow: 0 0 8px rgba(255, 56, 96, 0.3);
        }

        .logs .logitm.ALERT {
            color: #ffb020 !important;
            border-left-color: rgba(255, 176, 32, 0.5);
        }

        /* ============================================
           Empty state
           ============================================ */
        .logs:empty::after,
        .logs:not(:has(.logitm))::after {
            content: '> waiting for logs_';
            display: block;
            color: #5a6675;
            font-style: italic;
            padding: 20px 0;
            animation: blink 1.2s step-end infinite;
        }

        @keyframes blink {
            0%, 50% { opacity: 1; }
            51%, 100% { opacity: 0.3; }
        }

        /* ============================================
           MOBILE
           ============================================ */
        @media (max-width: 768px) {
            .ui.container {
                padding: 12px 10px 32px !important;
            }

            .ui.segment {
                padding: 16px 12px !important;
                border-radius: 16px !important;
            }

            .logs {
                min-height: 500px !important;
                max-height: 75vh !important;
                padding: 48px 12px 14px 12px !important;
                font-size: 12px !important;
                line-height: 1.6 !important;
                border-radius: 12px !important;
            }

            .logs::before {
                top: -48px;
                margin: -48px -12px 14px -12px;
                padding: 11px 14px;
                font-size: 0.62rem;
                letter-spacing: 1.2px;
            }

            .logs .logitm {
                padding: 7px 10px 7px 12px;
                margin: 3px 0;
                font-size: 11.5px;
                line-height: 1.55;
                word-break: break-word;
            }

            /* Prevent zoom on iOS */
            .logs::-webkit-scrollbar {
                width: 6px;
            }
        }

        /* Small phones */
        @media (max-width: 400px) {
            .logs {
                font-size: 11px !important;
                padding-left: 10px !important;
                padding-right: 10px !important;
            }

            .logs .logitm {
                font-size: 10.5px;
                padding: 6px 8px 6px 10px;
            }
        }

        /* iOS safe area */
        @supports (padding: env(safe-area-inset-top)) {
            .ui.container {
                padding-left: max(16px, env(safe-area-inset-left)) !important;
                padding-right: max(16px, env(safe-area-inset-right)) !important;
            }
        }
    </style>

    <script>
        gtag('event', 'screen_view', {
            'screen_name': 'logs',
            'app_name': 'flash'
        });
    </script>

    <div class="ui container">
        <% include partials/header.ejs %>
        <div class="ui segment">
            <div class="logs" id="logsBox">
                <% logs.forEach((log) => { %>
                <div class="logitm <%= log.type %>">
                    <%= new Date(log.time).toLocaleString('en-GB', { timeZone: 'UTC' }) %> =>
                    <%= log.type %> | <%= log.message %> </div>
                <% }) %>
            </div>
        </div>
    </div>

    <script>
        // Auto-scroll to bottom on load (latest logs at bottom)
        document.addEventListener('DOMContentLoaded', function () {
            var logsBox = document.getElementById('logsBox');
            if (logsBox) {
                logsBox.scrollTop = logsBox.scrollHeight;
            }
        });
    </script>

    <% include partials/footer.ejs %>
</body>

</html>